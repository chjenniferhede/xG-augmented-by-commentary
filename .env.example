# Copy to .env and fill in.
# YouTube Data API key (free): Google Cloud console > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=
# Postgres (Supabase): dashboard > Connect > Direct connection > URI. Direct is IPv6-only on the
# free plan; on a network without IPv6 use the Session pooler URI (port 5432) instead.
# Percent-encode special characters in the password. Unset = local SQLite in data/db/.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Optional: keep data somewhere other than ./data (relative paths are relative to the repo)
# XG_DATA_DIR=data
# Optional: YouTube scraping requests allowed per pipeline run (default 800)
# XG_YOUTUBE_BUDGET=800
# Optional: alignment speed. Defaults are slow and safe; raising them raises the chance of a YouTube block.
# XG_FRAME_INTERVAL=2.0     # seconds between frame requests
# XG_FRAME_PER_HOUR=600     # frame requests per hour
# XG_ALIGN_WORKERS=1        # frames fetched in parallel
# --- Commentary -> xG annotation (annotate/) ---
# Model provider: google (free tier, default) | groq | openrouter
LLM_PROVIDER=google
# google: gemini-3.8-flash or gemini-3.6-flash. NOTE gemini-2.5-* needs prior usage history on the
# account and 400s on a brand-new key. groq: openai/gpt-oss-120b
LLM_MODEL=gemini-3.8-flash
# Google AI Studio key (free, no card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Only needed if LLM_PROVIDER is set to them
# GROQ_API_KEY=
# OPENROUTER_API_KEY=